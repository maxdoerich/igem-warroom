# Optional. GitLab personal access token with only the `read_api` scope.
# Without it the app runs on the anonymous budget (600 requests/hour).
GITLAB_TOKEN=

# Server port (the Vite dev server proxies /api here)
PORT=8787

# How often to check gitlab.igem.org for new activity
POLL_INTERVAL_SEC=180

# Team slug to highlight on the map
HOME_TEAM=heidelberg

# Wiki freeze (UTC)
WIKI_FREEZE_AT=2026-10-21T15:00:00Z
